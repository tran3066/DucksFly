# DucksFly frontend config. Copy to `.env.local` and edit as needed.
#
# WebSocket URL of the Colyseus server the client connects to.
# - Local (default):        ws://localhost:2567
# - Same Wi-Fi / LAN:       ws://<host-machine-ip>:2567   (e.g. ws://192.168.1.42:2567)
# - Tunnel / deployed host: wss://your-host.example.com
VITE_SERVER_URL=ws://localhost:2567
